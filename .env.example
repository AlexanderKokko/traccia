# ---------------------------------------------------------------------------
# Supabase — accounts and cross-device sync
#
# Copy this file to .env.local and fill in your project's values:
#   Supabase dashboard → Project Settings → API
#
# The anon key is safe in the browser: it only grants what row-level security
# allows, and every table is restricted to the signed-in user's own rows.
# NEVER put the service_role key here — it bypasses RLS entirely.
#
# Leave these unset to run against the device-local store instead: the app still
# works, but there are no accounts and nothing syncs (an amber banner says so).
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Sample data — device-local mode only, never a real account
#   dev  — on by default; set to "false" to start from an empty diary
#   prod — off by default; set to "true" only for a demo deployment
# ---------------------------------------------------------------------------
VITE_SEED_DEMO=false
